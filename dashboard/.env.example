# Vite build-time env for the INNtelligence dashboard.
# Copy to dashboard/.env.local (gitignored) for local dev, and set the same
# vars in Railway so they're embedded at `npm run build`.
#
# The Supabase URL is public; the anon key is public-safe (RLS protects data).
# When BOTH are present the app uses real Supabase Auth (login required).
# When absent, the app runs in open / demo mode (no login wall).

VITE_SUPABASE_URL=https://pyiduxhqqlcahgacmmht.supabase.co
VITE_SUPABASE_ANON_KEY=
