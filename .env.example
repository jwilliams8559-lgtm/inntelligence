# The Gracious Collection — environment variables
# Copy to .env (local) or set in Railway dashboard (production).

# ── Supabase (existing) ─────────────────────────────────────────
SUPABASE_URL=https://pyiduxhqqlcahgacmmht.supabase.co
SUPABASE_SERVICE_KEY=...
SUPABASE_ANON_KEY=...

# ── Anthropic (for /api/onboarding/suggest-rooms) ───────────────
ANTHROPIC_API_KEY=

# ── Stripe (required before enabling real checkout) ─────────────
# Set these in Railway before turning on live billing. Without
# STRIPE_SECRET_KEY, engine/billing.py runs in mock mode.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Price IDs per plan tier (Starter $399 / Professional $699 /
# Enterprise $1,200 / Premium $2,400 / Founding free→$699).
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ENTERPRISE=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_FOUNDING_MEMBER=

# ── Public URL (used in Stripe success_url) ─────────────────────
APP_PUBLIC_URL=https://app.graciouscollection.com

# ── CORS extras (comma-separated) ───────────────────────────────
CORS_EXTRA_ORIGINS=

# ── Flask ───────────────────────────────────────────────────────
FLASK_ENV=production

# ── ElevenLabs (premium voice for /tour narration) ────────
ELEVENLABS_API_KEY=

# ── Auth / provisioning / email ─────────────────────────────────
# Supabase Auth uses SUPABASE_URL + SUPABASE_ANON_KEY (above) for login,
# and SUPABASE_SERVICE_KEY for admin provisioning (create users, tenants).
# Public base URL used in welcome-email login links:
APP_PUBLIC_URL=https://app.inntelligence.app
# SendGrid for welcome emails (REST API; no SDK required):
SENDGRID_API_KEY=
WELCOME_FROM_EMAIL=jim@graciouscollection.com
# Onboarding-call scheduling link placed in welcome emails:
CALENDLY_URL=https://calendly.com/inntelligence/onboarding
